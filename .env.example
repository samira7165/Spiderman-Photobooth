# =============================================================
# SPIDERMAN PHOTOBOOTH — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env and fill in your values
# =============================================================

# --- Database (local MySQL for dev; swap for a hosted MySQL URL in prod) ---
DATABASE_URL="mysql://root:localdevpass@localhost:3307/spiderman_photobooth"

# --- Storage (leave unset locally -> writes to /public/generated) ---
# Set this in Vercel's env vars (auto-filled when you connect a Blob store)
# to switch image/QR uploads over to Vercel Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Gemini (PRIMARY AI) ---
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash-exp"  # Your boss will tell you which model

# --- OpenAI (FALLBACK AI) ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-image-1"  # Your boss will tell you which model

# --- App Config ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"  # Change to your Vercel URL in production

# --- Admin Dashboard ---
# SESSION_SECRET signs the admin login cookie — keep it secret.
SESSION_SECRET=change-this-to-a-random-string

# ADMIN_EMAIL / ADMIN_BOOTSTRAP_PASSWORD are only used once, by
# `node prisma/seed.js`, to create the very first admin account.
# There is no signup page — every admin after that is added from
# inside the dashboard by someone already logged in.
# Safe to remove these two lines after running the seed script.
ADMIN_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-password
